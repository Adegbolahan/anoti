#!/bin/bash

# Pre-push hook for version checking
# Reminds to update plugin version when pushing changes

PLUGIN_JSON="project-scaffolder/.claude-plugin/plugin.json"

# Get the current version
if [ -f "$PLUGIN_JSON" ]; then
    CURRENT_VERSION=$(grep -o '"version": "[^"]*"' "$PLUGIN_JSON" | cut -d'"' -f4)

    # Check if plugin files changed since last tag/release
    CHANGED_FILES=$(git diff --name-only origin/main...HEAD 2>/dev/null | grep -E "^project-scaffolder/" | grep -v ".claude-plugin/plugin.json" || true)
    VERSION_CHANGED=$(git diff --name-only origin/main...HEAD 2>/dev/null | grep -E "plugin.json$" || true)

    if [ -n "$CHANGED_FILES" ] && [ -z "$VERSION_CHANGED" ]; then
        echo ""
        echo "=================================================="
        echo "  VERSION CHECK"
        echo "=================================================="
        echo ""
        echo "  Plugin files changed but version not updated!"
        echo "  Current version: $CURRENT_VERSION"
        echo ""
        echo "  Changed files:"
        echo "$CHANGED_FILES" | sed 's/^/    - /'
        echo ""
        echo "  To bump version, run:"
        echo "    ./scripts/bump-version.sh patch  # 1.0.1 -> 1.0.2"
        echo "    ./scripts/bump-version.sh minor  # 1.0.1 -> 1.1.0"
        echo "    ./scripts/bump-version.sh major  # 1.0.1 -> 2.0.0"
        echo ""
        echo "=================================================="
        echo ""

        # Ask user to confirm push without version bump
        read -p "Push anyway without version bump? (y/N) " -n 1 -r
        echo
        if [[ ! $REPLY =~ ^[Yy]$ ]]; then
            echo "Push aborted. Please update version first."
            exit 1
        fi
    fi
fi

exit 0
