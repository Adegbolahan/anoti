#!/bin/bash
# anoti-dir [--require] — print the resolved state dir (root-marker walk-up).
# Issue #13: a helper run from a subdirectory must hit the project's
# store, never mint a stray one; --require fails loudly when unanchored.
# Markers, checked case-exactly per #11, nearest directory wins:
#   .claude/anoti.local.md with state_dir:  ->  that dir/<state_dir>
#   GROUNDING.yaml or .anoti/               ->  that dir/.anoti
# ANOTI_DIR env overrides everything, verbatim. Unanchored: the
# back-compat cwd-relative ".anoti" — unless --require, which fails
# loudly instead. Writers pass --require so a wrong cwd is a loud error.
set -u
req=""
[ "${1:-}" = "--require" ] && req=1
if [ -n "${ANOTI_DIR:-}" ]; then printf '%s\n' "$ANOTI_DIR"; exit 0; fi
has() { command ls -1a "$1" 2>/dev/null | grep -qxF "$2"; }
d="$(pwd -P)"
while :; do
  if [ -f "$d/.claude/anoti.local.md" ] && has "$d/.claude" "anoti.local.md"; then
    v="$(sed -n '/^---$/,/^---$/{ /^state_dir:/{ s/state_dir: *//; s/[[:space:]]*$//; p; }; }' "$d/.claude/anoti.local.md" | head -1)"
    if [ -n "$v" ]; then
      case "$v" in /*) printf '%s\n' "$v" ;; *) printf '%s\n' "$d/$v" ;; esac
      exit 0
    fi
  fi
  if { [ -f "$d/GROUNDING.yaml" ] && has "$d" "GROUNDING.yaml"; } \
    || { [ -d "$d/.anoti" ] && has "$d" ".anoti"; }; then
    printf '%s\n' "$d/.anoti"
    exit 0
  fi
  [ "$d" = "/" ] && break
  d="$(dirname "$d")"
done
if [ -n "$req" ]; then
  echo "anoti-dir: no anoti workspace found walking up from $PWD — run inside a governed project or set ANOTI_DIR" >&2
  exit 1
fi
printf '.anoti\n'
