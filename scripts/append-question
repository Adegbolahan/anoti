#!/bin/bash
# append-question <store.yaml>   (question as JSON on stdin)
# Mechanical open_questions append — the write the consolidate skill
# mandates when promoting surviving doubts. Validates before moving;
# preserves the store's file mode.
set -u
f="${1:?usage: append-question <store> < question.json}"
SELF="$(cd "$(dirname "$0")" && pwd)"
json="$(cat)"
printf '%s' "$json" | jq -e '.' >/dev/null 2>&1 || { echo "append-question: stdin is not valid JSON" >&2; exit 1; }
Q="$json" yq '.open_questions += [strenv(Q) | fromjson]' "$f" > "$f.tmp" || { rm -f "$f.tmp"; exit 1; }
"$SELF/validate-workspace" "$f.tmp" >/dev/null 2>&1 || { rm -f "$f.tmp"; echo "append-question: result failed validation; store untouched" >&2; exit 1; }
pm="$(stat -f %Lp "$f" 2>/dev/null || stat -c %a "$f" 2>/dev/null || echo "")"
[ -n "$pm" ] && chmod "$pm" "$f.tmp" 2>/dev/null
mv "$f.tmp" "$f"
exit 0
