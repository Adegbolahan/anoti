#!/bin/bash
# Stop hook: block exactly once per episode when candidates await consolidation;
# block once per session while review debt this session opened is still open;
# nudge once per nontrivial session that has recorded no retrospective. Fail-open.
set -u
SELF="$(cd "$(dirname "$0")" && pwd)"
AD="$("$SELF/anoti-dir")"
input="$(cat 2>/dev/null || true)"
sid="$(printf '%s' "$input" | jq -r '.session_id // empty' 2>/dev/null)" || exit 0
[ -n "$sid" ] || exit 0
[ "$(printf '%s' "$input" | jq -r '.stop_hook_active // false' 2>/dev/null)" = "true" ] && exit 0
# review debt (spec docs/specs/2026-08-19-review-debt-design.md §4.4): block
# once per session while a row THIS session opened is still `open`. Runs only
# when the consolidation check above did not block (one decision per stop);
# deferred rows and other sessions' rows never block. Fail-open on a
# malformed ledger.
review_debt_block() {
  rd="$AD/review-debt.tsv"
  [ -f "$rd" ] || return 0
  mk="$AD/sessions/$sid.review-debt-blocked"
  [ -f "$mk" ] && return 0
  # whole-file shape check inside the awk: any malformed non-empty line ->
  # the ledger is treated as empty (fail-open; the helpers refuse to write
  # through it too, so the two surfaces agree)
  rows="$(awk -F'\t' -v s="$sid" 'NF==0{next} NF!=7||$1!~/^R[0-9]+$/||$2!~/^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]$/||($5!="open"&&$5!="deferred"&&$5!="closed"){bad=1;exit} $3==s && $5=="open" { r=r $1 " " $4 "; "; i=i sep $1; sep="," } END { if (!bad && r!="") printf "%s\t%s", r, i }' "$rd" 2>/dev/null)"
  [ -n "$rows" ] || return 0
  tab="$(printf '\t')"; ids="${rows##*"$tab"}"; rows="${rows%"$tab"*}"
  mkdir -p "$AD/sessions" 2>/dev/null; : > "$mk" 2>/dev/null
  printf '%s\t%s\t%s\t%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$sid" "review-debt" "block" "$ids" >> "$AD/telemetry.log" 2>/dev/null || true
  jq -n --arg r "anoti: adversarial review owed for work this session opened: ${rows%; } — run the reviewer and close the row (anoti review-debt close <id> \"<verdict>\"), or defer it with a written reason (anoti review-debt defer <id> \"<reason>\"). Silent skipping is the failure mode this gate exists to prevent (D026)." '{decision:"block",reason:$r}'
  exit 0
}
# retrospect nudge (human ask 2026-08-22 — "skillify should have a session-end
# hook that nudges the agent to check if there's anything to skillify"): a
# SessionEnd hook cannot reach the model, so the Stop hook asks instead — once
# per session, when the session is nontrivial (a slow classification, a frame,
# or >= NUDGE_EVENTS presence/inhibit telemetry lines) and no retrospective has
# been recorded (mark-retrospect). Runs only when nothing above blocked.
# cleanup-session (SessionEnd) keeps the state as abandoned when the check
# never happened, so the next session's digest surfaces it.
# Stop fires at the end of EVERY turn (never only at close), so this cannot
# know the session is ending. Contract: remind ONCE when the session first
# turns nontrivial, and once more if a recorded retrospective goes stale
# (>= NUDGE_EVENTS presence/inhibit events after the last mark). The real
# close path is cleanup-session (SessionEnd): an unrecorded or stale
# retrospective keeps the state as abandoned, and the next session's digest
# surfaces it for the reopen procedure (policy-retrospect).
nudge_threshold() { case "${NUDGE_EVENTS:-}" in ''|*[!0-9]*|0) echo 40 ;; *) echo "$NUDGE_EVENTS" ;; esac; }
retrospect_nudge() {
  mk="$AD/sessions/$sid.retrospect-nudged"
  th="$(nudge_threshold)"
  # column-anchored (awk, not an unanchored ERE with the sid as a pattern):
  # events = presence/inhibit lines for this sid; after = those after the
  # LAST mark-retrospect line for this sid (or all, when none)
  read -r ev after marked <<EOF2
$(awk -F'\t' -v s="$sid" '$2==s && ($3=="presence"||$3=="inhibit") {n++; a++} $2==s && $3=="retrospect" {m=1; a=0} END {printf "%d %d %d\n", n+0, a+0, m+0}' "$AD/telemetry.log" 2>/dev/null || echo "0 0 0")
EOF2
  case "$ev$after$marked" in ''|*[!0-9]*) return 0 ;; esac
  if [ "$marked" -eq 1 ]; then
    # recorded: re-arm only when stale, and only once per WINDOW of th events
    # (the marker stores the event count at the last stale reminder; `after`
    # grows every turn, so an equality check would re-block every turn)
    [ "$after" -ge "$th" ] || return 0
    if [ -f "$mk" ]; then
      last="$(cat "$mk" 2>/dev/null)"; last="${last#stale:}"
      # a fresh mark resets `after` below the stored count: the window restarts
      # from that mark, so `after >= th` alone re-arms; otherwise once per th
      case "$last" in ''|*[!0-9]*) ;; *) if [ "$after" -ge "$last" ]; then [ $((after - last)) -ge "$th" ] || return 0; fi ;; esac
    fi
    reason="anoti: the retrospective recorded for this session is stale — $after tool events since it (threshold $th). Before this session ends, re-run policy-retrospect over the later work (anything to skillify? irrelevant injections?) and record it again: anoti mark-retrospect $sid empty|filed irrelevant-injections N [<id>:<trigger> ...]. A stale mark keeps the state as abandoned at session end."
    note="stale after=$after"
    mkdir -p "$AD/sessions" 2>/dev/null; printf 'stale:%s' "$after" > "$mk" 2>/dev/null
  else
    [ -f "$mk" ] && return 0
    slow=0; frames=0
    if [ -f "$sf" ] && yq -e '.' "$sf" >/dev/null 2>&1; then
      slow="$(yq -r '[.classifications // [] | .[] | select(.verdict == "slow")] | length' "$sf" 2>/dev/null || echo 0)"
      frames="$(yq -r '.frames // [] | length' "$sf" 2>/dev/null || echo 0)"
    fi
    case "$slow$frames" in *[!0-9]*) return 0 ;; esac
    [ "$slow" -gt 0 ] || [ "$frames" -gt 0 ] || [ "$ev" -ge "$th" ] || return 0
    reason="anoti: this session is now nontrivial and no retrospective is recorded (policy-retrospect). Before it ends: anything to skillify? — a procedure performed twice becomes a queue entry (anoti append-todo <todos> \"skillify: <steps>\") or a skill now (skillify skill); count the presence injections that were irrelevant; then record it: anoti mark-retrospect $sid empty|filed irrelevant-injections N [<id>:<trigger> ...]. This reminder fires once; unrecorded (or recorded then followed by $th+ more tool events), the session state is kept as abandoned and resurfaces next session."
    note="slow=$slow frames=$frames events=$ev"
    mkdir -p "$AD/sessions" 2>/dev/null; printf 'first' > "$mk" 2>/dev/null
  fi
  printf '%s\t%s\t%s\t%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$sid" "retrospect-nudge" "block" "$note" >> "$AD/telemetry.log" 2>/dev/null || true
  jq -n --arg r "$reason" '{decision:"block",reason:$r}'
  exit 0
}
review_debt_then_nudge() { review_debt_block; retrospect_nudge; }
sf="$AD/sessions/$sid.yaml"
if [ ! -f "$sf" ]; then review_debt_then_nudge; exit 0; fi
if ! yq -e '.' "$sf" >/dev/null 2>&1; then
  echo "anoti: session state unreadable ($sf) — failing open; repair or remove it" >&2
  exit 0
fi
if [ "$(yq -r '.episode // "idle"' "$sf" 2>/dev/null)" != "candidate-detected" ]; then review_debt_then_nudge; exit 0; fi
yq '.episode = "awaiting-approval"' "$sf" > "$sf.tmp" 2>/dev/null && mv "$sf.tmp" "$sf"
jq -n '{decision:"block",reason:"anoti: memory candidates await consolidation. Review the candidates in the session state file and run /anoti:consolidate to propose them to the human, or set episode: idle to skip."}'
exit 0
