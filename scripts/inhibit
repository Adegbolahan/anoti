#!/bin/bash
# PreToolUse decision table. deny-list v1 — versioned here; complete; not runtime-extensible.
# Fail-open: any parse error -> exit 0 with no decision (allow).
set -u
SELF="$(cd "$(dirname "$0")" && pwd)"
AD="$("$SELF/anoti-dir")"
input="$(cat 2>/dev/null || true)"
tool="$(printf '%s' "$input" | jq -r '.tool_name // empty' 2>/dev/null)" || exit 0
[ -n "$tool" ] || exit 0
sid="$(printf '%s' "$input" | jq -r '.session_id // empty' 2>/dev/null || true)"
decide() {
  if [ -d "$AD" ]; then
    printf '%s\t%s\t%s\t%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "${sid:-?}" "inhibit" "$1" "$2" >> "$AD/telemetry.log" 2>/dev/null || true
  fi
  jq -n --arg d "$1" --arg r "$2" \
    '{hookSpecificOutput:{hookEventName:"PreToolUse",permissionDecision:$d,permissionDecisionReason:$r}}'
  exit 0
}
case "$tool" in
  Write|Edit|NotebookEdit)
    p="$(printf '%s' "$input" | jq -r '.tool_input.file_path // .tool_input.notebook_path // empty' 2>/dev/null)"
    case "$p" in
      *ROADMAP.md|*HIGH-LEVEL-STORIES.md|*GROUNDING.yaml|*TODOS.md|*LESSONS-LEARNT.md)
        # the plugin's OWN packaged templates share organ basenames but
        # are source files, not memory — exempt exactly that directory
        # (resolved from this script's location), never any project's
        # templates/ dir (reviewer: an unscoped pattern exempted every
        # consumer project's templates/TODOS.md etc.)
        tdir="$(cd "$SELF/../templates" 2>/dev/null && pwd -P)"
        pdir="$(cd "$(dirname "$p")" 2>/dev/null && pwd -P)"
        # the LEAF must be a real file inside that dir too — a symlink
        # planted at templates/GROUNDING.yaml pointing at a live store
        # would otherwise ride the exemption (cycle-2 review)
        if [ -n "$tdir" ] && [ "$pdir" = "$tdir" ] && [ ! -L "$p" ]; then exit 0; fi ;;
    esac
    case "$p" in
      *ROADMAP.md|*HIGH-LEVEL-STORIES.md)
        ep="idle"
        if [ -n "$sid" ] && [ -f "$AD/sessions/$sid.yaml" ]; then
          if yq -e '.' "$AD/sessions/$sid.yaml" >/dev/null 2>&1; then
            ep="$(yq -r '.episode // "idle"' "$AD/sessions/$sid.yaml" 2>/dev/null || echo idle)"
          else
            echo "anoti: session state unreadable ($AD/sessions/$sid.yaml) — treating episode as idle; repair or remove it" >&2
          fi
        fi
        case "$ep" in
          awaiting-approval|committed) exit 0 ;;
          *) decide deny "human-owned direction organ (episode=$ep) — agents draft via the direction skill and the human ratifies (policy-draft-for-ratification); apply only a human-ratified draft, with the episode open (scripts/set-episode $sid awaiting-approval). Unratified direct edits are reverted; these organs have no mechanical helper by design" ;;
        esac ;;
      *GROUNDING.yaml|*TODOS.md|*LESSONS-LEARNT.md)
        ep="idle"
        if [ -n "$sid" ] && [ -f "$AD/sessions/$sid.yaml" ]; then
          if yq -e '.' "$AD/sessions/$sid.yaml" >/dev/null 2>&1; then
            ep="$(yq -r '.episode // "idle"' "$AD/sessions/$sid.yaml" 2>/dev/null || echo idle)"
          else
            echo "anoti: session state unreadable ($AD/sessions/$sid.yaml) — treating episode as idle; repair or remove it" >&2
          fi
        fi
        case "$ep" in
          awaiting-approval|committed) exit 0 ;;
          *) decide deny "memory-organ write outside an active consolidation flow (episode=$ep). Unblock: scripts/set-episode $sid awaiting-approval, write via the helpers, then scripts/set-episode $sid committed — or run /anoti:consolidate" ;;
        esac ;;
    esac
    # branch protection: edit actions never land on the default branch —
    # feature branch or worktree (git skill). Organ writes exit above:
    # the episode gate alone governs them. Fail-open on any git error.
    [ -n "$p" ] || exit 0
    [ -f "$AD/allow-default-branch" ] && exit 0
    d="$(dirname "$p")"; [ -d "$d" ] || d="."
    br="$(git -C "$d" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
    [ -n "$br" ] || exit 0
    git -C "$d" check-ignore -q "$p" 2>/dev/null && exit 0
    db="$(git -C "$d" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null || true)"; db="${db#origin/}"
    if [ "$br" = "${db:-main}" ] || [ "$br" = "main" ] || [ "$br" = "master" ]; then
      decide deny "edit action on the default branch ($br) — implement on a feature branch or worktree (git skill). Human-gated override: touch $AD/allow-default-branch"
    fi ;;
  Bash)
    c="$(printf '%s' "$input" | jq -r '.tool_input.command // empty' 2>/dev/null)"
    # deny row 1: recursive delete of /, ~, or repo root
    if printf '%s' "$c" | grep -qE '(^|[;&| ])rm .*-rf? +("?/"?|~|\.)($|[ ;&|])|(^|[;&| ])rm .*-rf? +~/'; then
      decide deny "catastrophic: recursive delete of /, ~, or repo root"
    fi
    # deny row 2: force-push to default branch — scoped to one command
    # segment so flags from other commands (gh api -f) cannot combine
    if printf '%s' "$c" | tr ';&|' '\n' | grep -E 'git push' | grep -E '[[:space:]](--force|-f)([[:space:]]|$)' | grep -qE '[[:space:]](main|master)([[:space:]]|$)'; then
      decide deny "catastrophic: force-push to default branch"
    fi
    # deny row 3: destructive SQL at non-local target — requires BOTH a
    # SQL-shaped statement AND a DB client in the command: the word
    # "truncate" in prose written via heredoc or a commit message is not
    # SQL (field review 2026-08-18: a file write was blocked for it)
    if printf '%s' "$c" | grep -qiE 'DROP DATABASE|TRUNCATE[[:space:]]+(TABLE[[:space:]]+)?[A-Za-z_"`]' \
      && printf '%s' "$c" | grep -qiE '(^|[[:space:]|;&(])(psql|mysql|mariadb|sqlite3|sqlcmd|clickhouse-client|cockroach|supabase|prisma)([[:space:]]|$)' \
      && ! printf '%s' "$c" | grep -qE 'localhost|127\.0\.0\.1'; then
      decide deny "catastrophic: destructive SQL against non-local target"
    fi
    # ask row: consequential commands
    if printf '%s' "$c" | grep -qE '(^|[;&| ])(git push|npm publish|terraform (apply|destroy)|kubectl (delete|apply)|gh release|rm -r[a-zA-Z]* |git branch -[dD] +(main|master)([[:space:]]|$))'; then
      decide ask "consequential action — confirm it traces to the current goal"
    fi
    ;;
esac
exit 0
