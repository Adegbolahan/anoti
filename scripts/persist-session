#!/bin/bash
# PreCompact hook: ensure session state exists and stamp a flush time. Fail-open.
set -u
SELF="$(cd "$(dirname "$0")" && pwd)"
# #13: no anchor, nothing to persist — an ungoverned dir must never
# gain a stray store from an automatic hook. Fail open.
AD="$("$SELF/anoti-dir" --require 2>/dev/null)" || exit 0
input="$(cat 2>/dev/null || true)"
sid="$(printf '%s' "$input" | jq -r '.session_id // empty' 2>/dev/null)" || exit 0
[ -n "$sid" ] || exit 0
d="$AD/sessions"; mkdir -p "$d" 2>/dev/null || exit 0
[ -f "$AD/.gitignore" ] || printf '*\n' > "$AD/.gitignore"
sf="$d/$sid.yaml"
if [ ! -f "$sf" ]; then
  printf 'session:\n  id: %s\nepisode: idle\n' "$sid" > "$sf.tmp" && mv "$sf.tmp" "$sf"
fi
yq ".session.flushed = \"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"" "$sf" > "$sf.tmp" 2>/dev/null && mv "$sf.tmp" "$sf"
exit 0
