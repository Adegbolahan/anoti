#!/bin/bash
# session-append <session-id> <frames|hypotheses|in_flight|candidates>
#   (JSON item on stdin)
# Mechanical, quoting-safe append to any session-state list the skills
# instruct. Frames are a LIST (keyed by your own id field) — multiple
# workstreams never clobber each other. Never hand-edit session YAML.
set -u
SELF="$(cd "$(dirname "$0")" && pwd)"
AD="$("$SELF/anoti-dir" --require)" || exit 1
sid="${1:?usage: session-append <session-id> <frames|hypotheses|in_flight|candidates> < item.json}"
key="${2:?list key required}"
case "$key" in frames|hypotheses|in_flight|candidates) ;;
  *) echo "session-append: key must be frames|hypotheses|in_flight|candidates" >&2; exit 1 ;; esac
json="$(cat)"
printf '%s' "$json" | jq -e '.' >/dev/null 2>&1 || { echo "session-append: stdin is not valid JSON" >&2; exit 1; }
d="$AD/sessions"; mkdir -p "$d"
am="$(printf '%s' "$json" | jq -r '.amends // empty' 2>/dev/null)"
[ -f "$d/.gitignore" ] || [ -f "$AD/.gitignore" ] || printf '*\n' > "$AD/.gitignore"
sf="$d/$sid.yaml"
. "$SELF/store-lock"
lock_store "$sf" || exit 1
trap 'unlock_store "$sf"' EXIT
if [ ! -f "$sf" ]; then
  printf 'session:\n  id: %s\nepisode: idle\n' "$sid" > "$sf.tmp.$$" && mv "$sf.tmp.$$" "$sf"
fi
if [ -n "$am" ] && [ "$key" = "frames" ]; then
  # exact comparison in shell — yq's == pattern-matches wildcards
  found=""
  while IFS= read -r cur; do
    [ "$cur" = "$am" ] && found=1
  done <<< "$(yq -r '.frames // [] | .[] | .id // ""' "$sf" 2>/dev/null)"
  [ -n "$found" ] || { echo "session-append: amends target '$am' not found in frames" >&2; exit 1; }
fi
K="$key" REC="$json" yq '.[strenv(K)] += [strenv(REC) | fromjson]' "$sf" > "$sf.tmp.$$" || { rm -f "$sf.tmp.$$"; exit 1; }
yq -e '.' "$sf.tmp.$$" >/dev/null 2>&1 || { rm -f "$sf.tmp.$$"; echo "session-append: refusing to write unparseable state" >&2; exit 1; }
mv "$sf.tmp.$$" "$sf"
exit 0
