#!/bin/bash
# set-status <store.yaml> <record-id> <speculative|probable|established> <note...>
# The review ritual's mechanical apply for claim-ladder movement (the
# epistemic half of issue #10): writes epistemic_status AND the
# promoted/demoted audit event atomically. Status moves only on
# evidence, ruled in /anoti:review — the note should cite it. Refuses a
# no-op (already at the value). Same contract as set-ratification.
set -u
f="${1:?usage: set-status <store> <record-id> <speculative|probable|established> <note...>}"
rid="${2:?record id required}"
val="${3:?status value required}"
shift 3
note="${*:?note required}"
rank() { case "$1" in speculative) echo 0 ;; probable) echo 1 ;; established) echo 2 ;; *) echo "" ;; esac; }
nr="$(rank "$val")"
[ -n "$nr" ] || { echo "set-status: value must be speculative|probable|established" >&2; exit 1; }
SELF="$(cd "$(dirname "$0")" && pwd)"
idx="$("$SELF/record-index" "$f" "$rid")" \
  || { echo "set-status: no record '$rid' in $f" >&2; exit 1; }
rtyp="$(yq -r ".records[$idx].type // \"\"" "$f")"
[ "$rtyp" = "claim" ] || { echo "set-status: '$rid' is type '${rtyp:-unset}' — epistemic_status moves are claims-only (spec)" >&2; exit 1; }
old="$(yq -r ".records[$idx].epistemic_status // \"\"" "$f")"
or_="$(rank "$old")"
[ "$val" = "$old" ] && { echo "set-status: '$rid' is already $val" >&2; exit 1; }
act="promoted"; [ -n "$or_" ] && [ "$nr" -lt "$or_" ] && act="demoted"
cp "$f" "$f.tmp"
TS="$(date -u +%Y-%m-%d)" V="$val" N="$note" A="$act" \
  yq -i ".records[$idx].epistemic_status = strenv(V) | .records[$idx].events += [{\"date\": strenv(TS), \"action\": strenv(A), \"by\": \"human\", \"note\": strenv(N)}]" "$f.tmp" \
  || { rm -f "$f.tmp"; exit 1; }
"$SELF/validate-workspace" "$f.tmp" >/dev/null 2>&1 || { rm -f "$f.tmp"; echo "set-status: result failed validation; store untouched" >&2; exit 1; }
pm="$(stat -c %a "$f" 2>/dev/null || stat -f %Lp "$f" 2>/dev/null || echo "")"
[ -n "$pm" ] && chmod "$pm" "$f.tmp" 2>/dev/null
mv "$f.tmp" "$f"
"$SELF/regen-index" "$f"
"$SELF/trust" "$f" >/dev/null 2>&1 \
  || echo "set-status: store written and indexed but NOT re-trusted — machine-wide scope requires explicit consent: scripts/trust --global $f" >&2
exit 0
