#!/bin/bash
# validate-workspace <store.yaml> — exit 0 valid; exit 1 with "invalid: ..." lines on stderr.
set -u
f="${1:?usage: validate-workspace <store.yaml>}"
err=0
fail() { echo "invalid: $1" >&2; err=1; }
yq -e '.' "$f" >/dev/null 2>&1 || { echo "invalid: not parseable YAML" >&2; exit 1; }
[ "$(yq -r '.meta.schema_version // ""' "$f")" = "3" ] || fail "meta.schema_version must be 3"
rtype="$(yq -r '.records | type' "$f" 2>/dev/null)"
[ "$rtype" = "!!seq" ] || fail "records must be a list"
n="$(yq -r '.records | length' "$f")"
# (relationship-target existence now checked inside the jq filter below,
# which computes its own $all_ids from the same extracted records JSON --
# no separate bash-side id cache needed.)
# Per-record checks used to be ~10 separate yq calls PER RECORD (each a
# full-file re-parse) -- O(records) subprocess spawns made this the
# dominant cost of scripts/presence's every-tool-call firing (measured:
# ~26s on a 300-record store, well over the JIT-recall spec's 1s hook
# budget -- docs/specs/2026-08-19-jit-recall-design.md's own perf
# requirement, verified via tests/test_presence.sh item 12). Rewritten as
# ONE yq JSON extraction + ONE jq pass over all records (measured: ~44ms
# on the same 300-record fixture), matching the house idiom already used
# by scripts/store-resolve's match_triggers (one extraction, no
# per-record subprocess). Same checks, same fail() call sites; only the
# subprocess count changed.
if [ "$rtype" = "!!seq" ] && [ "$n" -gt 0 ] 2>/dev/null; then
  errs="$(yq -o=json '.records' "$f" 2>/dev/null | jq -r "$(cat <<'JQ'
. as $recs
| ([$recs[] | (.id // "")]) as $all_ids
| [ range(0; ($recs | length)) as $i
    | $recs[$i] as $r
    | (
        (if (($r.id // "") == "") then ["records[\($i)]: missing id"] else [] end)
        + (if (["claim","preference","decision","goal","policy"] | index($r.type // "")) then [] else ["records[\($i)]: bad type '\($r.type // "")'"] end)
        + (if (($r.statement // "") == "") then ["records[\($i)]: missing statement"] else [] end)
        + (if (["pending","approved","rejected"] | index($r.ratification // "")) then [] else ["records[\($i)]: bad ratification '\($r.ratification // "")'"] end)
        + (if (($r.type // "") == "claim") then (if (["speculative","probable","established"] | index($r.epistemic_status // "")) then [] else ["records[\($i)]: claim missing/bad epistemic_status"] end) else [] end)
        + (
            ($r.triggers) as $trg
            | if ($trg == null) then []
              elif ($trg | type) == "array" then
                ( [$trg[] | select((type != "string") or (. == ""))] | length ) as $bad
                | if $bad == 0 then [] else ["records[\($i)]: triggers must be a list of non-empty strings (\($bad) bad element(s))"] end
              else ["records[\($i)]: triggers must be a list (got \($trg | type))"]
              end
          )
        + (
            (($r.source // {}) | keys) as $ks
            | ($ks - ["type","context","participants"]) as $bad
            | if ($bad | length) == 0 then [] else ["records[\($i)]: source has unexpected key(s): \($bad | join(" ")) (unquoted scalar split?)"] end
          )
        + (
            (($r.events // []) | map(keys) | add // []) as $ks
            | ($ks - ["date","action","by","note"] | unique) as $bad
            | if ($bad | length) == 0 then [] else ["records[\($i)]: event has unexpected key(s): \($bad | join(" ")) (unquoted scalar split?)"] end
          )
        + (
            (($r.evidence // []) | map(keys) | add // []) as $ks
            | ($ks - ["date","type","note","refs"] | unique) as $bad
            | if ($bad | length) == 0 then [] else ["records[\($i)]: evidence has unexpected key(s): \($bad | join(" ")) (unquoted scalar split?)"] end
          )
        + (
            (($r.relationships // []) | map(keys) | add // []) as $ks
            | ($ks - ["type","target","date","note"] | unique) as $bad
            | if ($bad | length) == 0 then [] else ["records[\($i)]: relationship has unexpected key(s): \($bad | join(" "))"] end
          )
        + (
            (($r.relationships // []) | map(.type // "") | unique) as $ts
            | ($ts - ["refines","contradicts","compares"]) as $bad
            | if ($bad | length) == 0 then [] else ["records[\($i)]: relationship type must be refines|contradicts|compares (got: \($bad | join(" ")))"] end
          )
        + (
            [ ($r.relationships // [])[] | (.target // "") | select(. != "") | select(. as $t | ($all_ids | index($t)) == null) ]
            | map("records[\($i)]: relationship target '\(.)' is not a record in this store")
          )
      )
  ] | flatten | .[]
JQ
)" 2>/dev/null)"
  if [ -n "$errs" ]; then
    while IFS= read -r eline; do
      [ -n "$eline" ] || continue
      fail "$eline"
    done <<EOF
$errs
EOF
  fi
fi
dups="$(yq -r '.records[].id' "$f" 2>/dev/null | sort | uniq -d)"
[ -z "$dups" ] || fail "duplicate ids: $(printf '%s' "$dups" | tr '\n' ' ')"
sc="$(yq -r '.meta.scope // ""' "$f" 2>/dev/null)"
if [ -n "$sc" ]; then
  loc=project
  case "$(cd "$(dirname "$f")" 2>/dev/null && pwd -P)/" in
    "$(cd "$HOME" 2>/dev/null && pwd -P)/.claude/anoti/"*) loc=global ;;
  esac
  [ "$sc" != "$loc" ] && echo "warning: meta.scope=$sc disagrees with location ($loc)" >&2
fi
exit "$err"
